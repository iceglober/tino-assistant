# Tino reads almost all of its configuration from the console Setup screen
# (stored in the config table). These env vars only bootstrap the process.

# ── Persistence ────────────────────────────────────────────────────────────
# sqlite (default, local dev, knowledge base off) or postgres (production).
PERSISTENCE_ADAPTER=
# sqlite file path (default ./tino.db) and better-auth's sqlite file (default /tmp/tino-auth.db).
DB_PATH=
AUTH_DB_PATH=
# Required when PERSISTENCE_ADAPTER=postgres.
DATABASE_URL=

# Master key for encrypting per-user credentials (Slack user tokens, Google
# refresh tokens, personal MCP tokens). Changing it makes stored tokens unreadable.
LOCAL_DEV_CRYPTO_KEY=

# ── Console ────────────────────────────────────────────────────────────────
PORT=3001
# Public URL of the console. Unset = local dev (email/password sign-in, first user is admin).
CONSOLE_BASE_URL=
# Only accounts on this domain may sign in (and auto-join, unless Users → access is invite-only).
CONSOLE_ALLOWED_DOMAIN=

# ── Knowledge base (postgres only) ─────────────────────────────────────────
# Vertex project for gemini-embedding-001. Unset = knowledge base off.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
# Set to 0 to disable the indexer even when Vertex is configured.
KB_ENABLED=

# ── Fallbacks (Setup values win when both are set) ─────────────────────────
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

LOG_LEVEL=info
