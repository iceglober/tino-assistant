# Platform settings for the operator of Tino. Customer settings (Slack apps,
# Google clients, model keys) live in each org's encrypted settings, never here.
# Everything is optional for local dev: `bun run dev` works with this file empty.

# ── Server ─────────────────────────────────────────────────────────────────
# Public URL. Unset = http://localhost:$PORT.
BASE_URL=
PORT=3001
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
# Postgres with pgvector ≥ 0.7 (Railway's Postgres 18 has it).
# Unset = PGlite, an in-process Postgres, stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# ── Secrets (required in production; `openssl rand -hex 32`) ───────────────
# Encrypts every stored credential and org secret. Never lose or rotate casually.
ENCRYPTION_KEY=
# Signs sessions and OAuth state.
AUTH_SECRET=

# ── Access ─────────────────────────────────────────────────────────────────
# open | closed. closed = private beta: invites and domain joins work, only
# ORG_CREATORS (emails or @domains, comma-separated) may create orgs.
SIGNUPS=open
ORG_CREATORS=

# ── Email (verification + invites). Unset = links are logged. ─────────────
RESEND_API_KEY=
EMAIL_FROM=Tino <hello@example.com>

# ── Tino's own OAuth clients (optional; see docs/managed-service.md) ────────
# Google: always used for "Sign in with Google" (basic scopes). Used for data
# access only up to its approval: none | verified (Calendar) | assessed (Gmail, after CASA).
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=
PLATFORM_GOOGLE_APPROVAL=none
# Offer data access above the approval to this many people (Google's unverified cap is 100). 0 = off.
PLATFORM_GOOGLE_PILOT_CAP=0
# Slack: a distributable Tino app. Only useful once Marketplace-approved (APPROVAL=assessed).
PLATFORM_SLACK_CLIENT_ID=
PLATFORM_SLACK_CLIENT_SECRET=
PLATFORM_SLACK_SIGNING_SECRET=
PLATFORM_SLACK_APPROVAL=none
# Restrict the platform clients to these org ids (comma-separated). Unset = all orgs.
PLATFORM_CLIENT_ORGS=

# ── Embeddings for orgs without their own OpenAI/Azure key (optional) ───────
PLATFORM_OPENAI_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
# 0 stops all knowledge-base indexing.
KB_ENABLED=1
