{
  "name": "tino",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --filter '@tino/server' --filter '@tino/web' dev",
    "dev:server": "bun run --filter '@tino/server' dev",
    "dev:web": "bun run --filter '@tino/web' dev",
    "build": "bun run --filter '@tino/web' build",
    "start": "bun run --filter '@tino/server' start",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.14",
    "railway": "3.12.0",
    "typescript": "^6.0.3"
  }
}
