{
  "name": "tino-assistant",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter @tino/core build",
    "start": "PERSISTENCE_ADAPTER=sqlite bun packages/core/src/bootstrap/main.ts",
    "start:full": "bun packages/core/src/bootstrap/main.ts",
    "dev": "PERSISTENCE_ADAPTER=sqlite bun --watch packages/core/src/bootstrap/main.ts",
    "dev:pg": "PERSISTENCE_ADAPTER=postgres DATABASE_URL=postgres://tino:tino@localhost:5433/tino bun --watch packages/core/src/bootstrap/main.ts",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "biome check --write .",
    "deploy:gcp": "bash scripts/gcp-deploy.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15"
  },
  "overrides": {
    "typescript": "^6.0.3"
  }
}
