{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "rootDir": "../",
    "outDir": "dist",
    "noEmit": true,
    "types": ["node", "bun"],
    "paths": {
      "@tino/core": ["../core/src/bootstrap/main.ts"],
      "@tino/core/env": ["../core/src/env.ts"],
      "@tino/core/ports": ["../core/src/ports/outbound.ts"],
      "@tino/core/domain/types": ["../core/src/domain/types.ts"],
      "@tino/core/identity/store": ["../core/src/infrastructure/driven/identity/store.ts"],
      "@tino/core/persistence/keys": ["../core/src/infrastructure/driven/persistence/keys.ts"],
      "@tino/core/persistence/memory-history": ["../core/src/infrastructure/driven/persistence/memory-history.ts"]
    }
  },
  "include": ["src/**/*"]
}
