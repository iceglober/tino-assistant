{
  "name": "@tino/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/bootstrap/main.js",
  "exports": {
    ".": {
      "default": "./dist/bootstrap/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build:console": "vite build",
    "dev": "tsx watch src/bootstrap/main.ts",
    "dev:console": "vite",
    "lint": "biome check .",
    "start": "tsx src/bootstrap/main.ts",
    "test": "bun --bun ./node_modules/vitest/dist/cli.js run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.102",
    "@ai-sdk/azure": "3.0.93",
    "@ai-sdk/google-vertex": "4.0.171",
    "@ai-sdk/mcp": "^1.0.43",
    "@ai-sdk/openai": "3.0.88",
    "@hono/node-server": "^2.0.2",
    "@slack/bolt": "^4.7.2",
    "@slack/web-api": "^7.15.1",
    "ai": "^6.0.178",
    "better-auth": "^1.6.11",
    "dotenv": "^17.4.2",
    "googleapis": "^171.4.0",
    "hono": "^4.12.18",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
