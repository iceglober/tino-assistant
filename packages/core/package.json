{
  "name": "@tino/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/bootstrap/main.js",
  "exports": {
    ".": {
      "default": "./dist/bootstrap/main.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./ports": {
      "types": "./dist/ports/outbound.d.ts",
      "default": "./dist/ports/outbound.js"
    },
    "./domain/types": {
      "types": "./dist/domain/types.d.ts",
      "default": "./dist/domain/types.js"
    },
    "./persistence/keys": {
      "types": "./dist/infrastructure/driven/persistence/keys.d.ts",
      "default": "./dist/infrastructure/driven/persistence/keys.js"
    },
    "./persistence/memory-history": {
      "types": "./dist/infrastructure/driven/persistence/memory-history.d.ts",
      "default": "./dist/infrastructure/driven/persistence/memory-history.js"
    },
    "./identity/store": {
      "types": "./dist/infrastructure/driven/identity/store.d.ts",
      "default": "./dist/infrastructure/driven/identity/store.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build:console": "vite build",
    "dev": "tsx watch src/bootstrap/main.ts",
    "dev:console": "vite",
    "lint": "biome check .",
    "start": "tsx src/bootstrap/main.ts",
    "test": "bun --bun ./node_modules/vitest/dist/cli.js run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.105",
    "@ai-sdk/anthropic": "3.0.102",
    "@ai-sdk/azure": "3.0.93",
    "@ai-sdk/openai": "3.0.88",
    "@aws-sdk/client-cloudwatch-logs": "^3.1045.0",
    "@aws-sdk/credential-providers": "^3.1045.0",
    "@hono/node-server": "^2.0.2",
    "@linear/sdk": "^84.0.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^4.7.2",
    "@slack/web-api": "^7.15.1",
    "ai": "^6.0.178",
    "better-auth": "^1.6.11",
    "dotenv": "^17.4.2",
    "googleapis": "^171.4.0",
    "hono": "^4.12.18",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
